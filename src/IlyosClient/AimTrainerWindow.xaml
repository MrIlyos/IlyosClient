<Window x:Class="IlyosClient.AimTrainerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ilyos Client — Aim Trainer" Width="640" Height="440"
 WindowStartupLocation="CenterOwner" Background="#0B1020" Foreground="#EAF2FF">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="AIM TRAINER" FontSize="22" FontWeight="Bold" Foreground="#2787FF" Margin="0,0,0,14"/>
  <Canvas x:Name="TrainingCanvas" Grid.Row="1" Background="#121B30" ClipToBounds="True" MouseLeftButtonDown="Canvas_Click"/>
  <TextBlock x:Name="ResultText" Grid.Row="2" Text="Нажимай на синие мишени." Margin="0,12,0,0" Foreground="#91A4C4"/>
 </Grid>
</Window>
